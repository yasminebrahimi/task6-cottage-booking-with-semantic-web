    :hasBookedPeriod
        cd:Cottage7Booking1 ,
        cd:Cottage7Booking2 .

# Named booked periods

cd:Cottage1Booking1 a owl:NamedIndividual, :BookedPeriod ;
    :periodStart "2026-12-20"^^xsd:date ;
    :periodEnd "2026-12-27"^^xsd:date .

cd:Cottage1Booking2 a owl:NamedIndividual, :BookedPeriod ;
    :periodStart "2027-01-10"^^xsd:date ;
    :periodEnd "2027-01-14"^^xsd:date .

