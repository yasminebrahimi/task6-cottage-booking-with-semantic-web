@prefix : <http://localhost:8080/cottage-booking/onto/cottage.owl#> .
@prefix cd: <http://localhost:8080/cottage-booking/data/cottages.ttl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .

# This dataset uses the vocabulary defined in the deployed OWL ontology.
# Class/property IRIs use cottage.owl#; instance IRIs use cottages.ttl#.

<http://localhost:8080/cottage-booking/data/cottages.ttl> a owl:Ontology ;
    owl:imports <http://localhost:8080/cottage-booking/onto/cottage.owl> .

# Cottage database for the "Cottage booking" service (7 cottages).
# All cottages, addresses and booked periods are fictional example data.
# Distances: lake in meters, city in kilometers. Periods include start and end day.
# Image URLs are placeholders: replace them with real cottage photos.

#  Cities

cd:Savonlinna a :City ; :cityName "Savonlinna" .
cd:Utajärvi a :City ; :cityName "Utajärvi" .
cd:Joensuu a :City ; :cityName "Joensuu" .
cd:Suomussalmi a :City ; :cityName "Suomussalmi" .
cd:Kuopio a :City ; :cityName "Kuopio" .
cd:Nuutilanmäki a :City ; :cityName "Nuutilanmäki" .
cd:Jyväskylä a :City ; :cityName "Jyväskylä" .

# Cottages

# 1
cd:Cottage1 a :Cottage ;
    :cottageName "Koskelan Huvila" ;
    :hasAddress "Kuokkalantie 1160, 58170 Enonkoski, Finland" ;
    :hasImage "http://localhost:8080/cottage-booking/images/cottage1.jpg"^^xsd:anyURI ;
    :hasCapacity 4 ;
    :hasBedrooms 2 ;
    :distanceFromLake 30 ;
    :nearestCity cd:Savonlinna ;
    :distanceToCity 6 ;
    :hasBookedPeriod
        cd:Cottage1Booking1 ,
        cd:Cottage1Booking2 . 

