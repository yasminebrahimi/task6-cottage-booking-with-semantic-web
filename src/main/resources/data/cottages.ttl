    :hasBookedPeriod
        cd:Cottage5Booking1 ,
        cd:Cottage5Booking2 .

# 6
cd:Cottage6 a :Cottage ;
    :cottageName "Cottage6" ;
    :hasAddress "Address 6" ;
    :hasImage "https://photos.com/image6"^^xsd:anyURI ;
    :hasCapacity 10 ;
    :hasBedrooms 5 ;
    :distanceFromLake 60 ;
