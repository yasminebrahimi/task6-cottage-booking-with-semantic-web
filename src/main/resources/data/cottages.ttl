@prefix : <http://localhost:8080/cottage-booking/onto/cottage.owl#> .
@prefix cd: <http://localhost:8080/cottage-booking/data/cottages.ttl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .

# This dataset uses the vocabulary defined in the deployed OWL ontology.
# Class/property IRIs use cottage.owl#; instance IRIs use cottages.ttl#.

<http://localhost:8080/cottage-booking/data/cottages.ttl> a owl:Ontology ;
    owl:imports <http://localhost:8080/cottage-booking/onto/cottage.owl> .

# Cottage database for the "Cottage booking" service (7 cottages).
# All cottages, addresses and booked periods are fictional example data.
# Distances: lake in meters, city in kilometers. Periods include start and end day.
# Image URLs are placeholders: replace them with real cottage photos.

#  Cities

cd:City1 a :City ; :cityName "City1" .
cd:City2 a :City ; :cityName "City2" .
cd:City3 a :City ; :cityName "City3" .
cd:City4 a :City ; :cityName "City4" .
cd:City5 a :City ; :cityName "City5" .
cd:City6 a :City ; :cityName "City6" .
cd:City7 a :City ; :cityName "City7" .

# Cottages

# 1
cd:Cottage1 a :Cottage ;
    :cottageName "Cottage1" ;
    :hasAddress "Address 1" ;
    :hasImage "https://photos.com/image1"^^xsd:anyURI ;
    :hasCapacity 4 ;
    :hasBedrooms 2 ;
    :distanceFromLake 30 ;
    :nearestCity cd:City1 ;
    :distanceToCity 6 ;
    :hasBookedPeriod
        cd:Cottage1Booking1 ,
        cd:Cottage1Booking2 . 

# 2
cd:Cottage2 a :Cottage ;
    :cottageName "Cottage2" ;
    :hasAddress "Address 2" ;
    :hasImage "https://photos.com/image2"^^xsd:anyURI ;
    :hasCapacity 6 ;
    :hasBedrooms 3 ;
    :distanceFromLake 120 ;
    :nearestCity cd:City2 ;
    :distanceToCity 18 ;
    :hasBookedPeriod
        cd:Cottage2Booking1 ,
        cd:Cottage2Booking2 .

